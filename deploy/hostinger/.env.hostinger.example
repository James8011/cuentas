APP_NAME="Finanzas del Hogar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hogar.sirvelo.online

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.sirvelo.online
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=hogar.sirvelo.online,sirvelo.online
FRONTEND_URL=https://hogar.sirvelo.online

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
MAIL_MAILER=log
